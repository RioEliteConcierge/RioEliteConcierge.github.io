---
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'Chi siamo',
  description:
    "Rio Elite Concierge: servizi di concierge su misura, fondati da Marco Valetto e affiancati da un'agenzia di viaggi partner.",
};

const values = [
  ['01', 'Su misura', 'Ogni richiesta è diversa: costruiamo il servizio intorno alle tue esigenze.'],
  ['02', 'Cura dei dettagli', "Dalla prenotazione all'ultimo dettaglio, niente viene lasciato al caso."],
  ['03', 'Riservatezza', 'Massima discrezione e trasparenza in ogni fase.'],
];

const guarantees = [
  {
    icon: 'tabler:building-store',
    title: 'Agenzia di viaggi autorizzata',
    description:
      "Le prenotazioni passano da un'agenzia regolarmente costituita, non solo da un singolo professionista.",
  },
  {
    icon: 'tabler:file-certificate',
    title: 'Pagamenti e contratti chiari',
    description: 'Condizioni scritte, documenti regolari e trasparenza su cosa è incluso.',
  },
  {
    icon: 'tabler:headset',
    title: 'Assistenza prima e durante il viaggio',
    description: "Un referente diretto (Marco) e un'agenzia alle spalle in caso di imprevisti.",
  },
];
---

<Layout metadata={metadata}>
  <main class="bg-[#e8e1d2] text-[#050505]">
    <!-- Hero -->
    <section
      class="relative flex min-h-[70svh] flex-col justify-center overflow-hidden bg-[#050505] px-4 pb-20 pt-32 text-[#f5f2e8] sm:px-6"
      aria-labelledby="about-title"
    >
      <div class="mx-auto w-full max-w-295">
        <p class="mb-5 text-[.68rem] font-bold uppercase tracking-[.2em] text-[#f0c95a]">CHI SIAMO</p>
        <h1
          id="about-title"
          class="max-w-4xl font-serif text-[clamp(3.2rem,10vw,7.5rem)] font-normal leading-[.9] tracking-[-.055em]"
        >
          Il tuo concierge<br /><em class="text-[#d9a62e]">di fiducia.</em>
        </h1>
        <p class="mt-7 max-w-md text-base leading-relaxed text-[#f5f2e8]/85 sm:text-xl">
          Ci occupiamo di tutto, così tu puoi pensare solo a goderti l'esperienza. <br>
          Servizi su misura, attenzione ai dettagli e un contatto diretto con chi ti segue.
        </p>
      </div>
    </section>

    <!-- Fondatore -->
    <section id="team" class="bg-[#e8e1d2] px-4 py-20 sm:px-6 sm:py-32">
      <div class="mx-auto flex w-full max-w-295 flex-col items-center text-center">
        <p class="mb-5 text-[.68rem] font-bold uppercase tracking-[.2em] text-[#9b6a21]">IL FONDATORE</p>
        <h2 class="font-serif text-[clamp(3rem,7vw,5.8rem)] font-normal leading-[.92] tracking-tighter">
          Chi c'è dietro<br /><em class="text-[#d9a62e]">Rio Elite.</em>
        </h2>

        <img
          src="/img/cosplayer.png"
          alt="Marco Valetto"
          class="mt-14 h-48 w-48 rounded-full border border-[#050505]/20 object-cover"
          loading="lazy"
        />
        <h3 class="mt-7 font-serif text-3xl font-normal">Marco Valetto</h3>
        <p class="mt-2 text-[.68rem] font-bold uppercase tracking-[.2em] text-[#9b6a21]">Fondatore &amp; Owner</p>
        <p class="mt-5 max-w-md leading-7 text-[#3a403a]">
          Fondatore di Rio Elite Concierge. <br /> Seguo personalmente ogni cliente, <br /> in collaborazione con NOME_AGENZIA
          (TODO)
        </p>
        <a
          class="mt-6 inline-flex items-center gap-2 border-b border-[#d9a62e] pb-1 font-bold text-[#050505] no-underline"
          href="https://www.instagram.com/marcovaletto/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram di Marco Valetto"
        >
          <Icon name="tabler:brand-instagram" size={20} />
          @marcovaletto
        </a>
      </div>
    </section>

    <!-- Agenzia partner -->
    <section id="partner" class="bg-[#050505] px-4 py-20 text-[#f5f2e8] sm:px-6 sm:py-32">
      <div class="mx-auto w-full max-w-295">
        <div class="mb-14 flex flex-col justify-between gap-7 md:mb-20 md:flex-row md:items-end">
          <div>
            <p class="mb-5 text-[.68rem] font-bold uppercase tracking-[.2em] text-[#f0c95a]">AFFIDABILITÀ</p>
            <h2 class="font-serif text-[clamp(3rem,7vw,5.8rem)] font-normal leading-[.92] tracking-tighter">
              Non siamo soli.<br /><em class="text-[#d9a62e]">Lavoriamo con professionisti.</em>
            </h2>
          </div>
          <p class="max-w-xs leading-7 text-[#f5f2e8]/70">
            Marco è affiancato da NOME_AGENZIA (TODO), agenzia di viaggi che gestisce la parte organizzativa e
            contrattuale, per darti la massima tranquillità.
          </p>
        </div>

        <div class="grid border-t border-[#f5f2e8]/25 md:grid-cols-3">
          {
            guarantees.map((item, index) => (
              <article class="border-b border-[#f5f2e8]/25 py-7 md:mr-6 md:border-b-0 md:border-r md:pr-6 last:mr-0 last:border-0">
                <span class="mb-10 block text-[.68rem] tracking-[.15em] text-[#f0c95a]">0{index + 1}</span>
                <Icon name={item.icon} size={30} stroke-Width={1.5} />
                <h3 class="mt-5 font-serif text-2xl font-normal">{item.title}</h3>
                <p class="mt-3 text-sm leading-7 text-[#f5f2e8]/65">{item.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Valori -->
    <section id="valori" class="bg-[#ded2bd] px-4 py-20 sm:px-6 sm:py-32">
      <div class="mx-auto w-full max-w-295">
        <div class="mb-14 md:mb-20">
          <p class="mb-5 text-[.68rem] font-bold uppercase tracking-[.2em] text-[#9b6a21]">COME LAVORIAMO</p>
          <h2 class="font-serif text-[clamp(3rem,7vw,5.8rem)] font-normal leading-[.92] tracking-tighter">
            I nostri<br /><em class="text-[#d9a62e]">valori.</em>
          </h2>
        </div>
        <div class="grid gap-8 md:grid-cols-3 md:gap-9">
          {
            values.map(([number, title, description]) => (
              <article class="border-t border-[#050505]/30 pt-5">
                <span class="mb-10 block text-[.68rem] tracking-[.15em] text-[#9b6a21]">{number}</span>
                <h3 class="font-serif text-2xl font-normal">{title}</h3>
                <p class="mt-3 leading-7 text-[#3a403a]">{description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Contatti -->
    <section
      id="contatti"
      class="relative grid min-h-120 place-items-center overflow-hidden border-t border-[#f5f2e8]/15 bg-[#050505] px-4 py-24 text-center text-[#f5f2e8] sm:px-6"
    >
      <div class="flex max-w-2xl flex-col items-center">
        <p class="mb-5 text-[.68rem] font-bold uppercase tracking-[.2em] text-[#f0c95a]">PARLIAMONE</p>
        <h2 class="font-serif text-[clamp(3.2rem,8vw,6.7rem)] font-normal leading-[.9] tracking-tighter">
          Raccontaci<br /><em class="text-[#d9a62e]">cosa cerchi.</em>
        </h2>
        <p class="my-7 max-w-md leading-7 text-[#f5f2e8]/80">
          Scrivici e ti rispondiamo il prima possibile. <br /> Costruiamo insieme il tuo prossimo ricordo.
        </p>
        <div class="flex flex-col items-center gap-5 sm:flex-row sm:gap-7">
          <a
            class="inline-flex items-center gap-2.5 rounded-full bg-[#d9a62e] px-5 py-3.5 text-sm font-bold text-[#050505] no-underline transition hover:-translate-y-0.5 hover:bg-[#f0c95a]"
            href="https://wa.me/+393465886627?text=Ciao%20sono%20interessato%20a%20saperne%20di%20più%20sui%20servizi%20di%20Rio%20Elite%20Concierge.%20Puoi%20aiutarmi%3F"
            target="_blank"
            rel="noopener noreferrer"
          >
            Scrivici su WhatsApp
            <Icon name="tabler:arrow-up-right" size={19} />
          </a>
          <a
            class="inline-flex items-center gap-2 border-b border-[#d9a62e] pb-1 font-bold text-[#f5f2e8] no-underline"
            href="https://www.instagram.com/marcovaletto/"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="tabler:brand-instagram" size={18} />
            Instagram
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
