---
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'Home',
  description:
    'Esperienze autentiche, accesso privilegiato e supporto personale per vivere Rio de Janeiro in modo indimenticabile.',
};

const services = [
  {
    icon: 'tabler:compass',
    title: 'Esperienze su misura',
    description: 'Un itinerario costruito intorno ai tuoi interessi, al tuo ritmo e al tuo modo di viaggiare.',
  },
  {
    icon: 'tabler:glass-full',
    title: 'Luoghi da insider',
    description: 'Ristoranti, rooftop, beach club e indirizzi selezionati oltre i soliti percorsi turistici.',
  },
  {
    icon: 'tabler:sparkles',
    title: 'Momenti memorabili',
    description: 'Dalla nightlife alla cultura locale: ogni dettaglio è pensato per farti vivere Rio davvero.',
  },
  {
    icon: 'tabler:headset',
    title: 'Supporto personale',
    description: 'Una persona al tuo fianco prima e durante il viaggio, quando hai bisogno di noi.',
  },
];

const steps = [
  [
    '01',
    'Raccontaci il tuo mood',
    'Food, musica, mare, cultura, nightlife, wellness o avventura: partiamo da ciò che ti appassiona.',
  ],
  [
    '02',
    'Creiamo la tua Rio',
    'Selezioniamo esperienze e luoghi coerenti con il tuo tempo, il tuo budget e il tuo stile.',
  ],
  ['03', 'Tu vivi il momento', 'Arrivi, esplori e ti godi la città. Al resto pensiamo noi.'],
];

const faqs = [
  [
    'Che cos’è Rio Elite Concierge?',
    'È un servizio di concierge personale che ti aiuta a vivere Rio de Janeiro attraverso esperienze, luoghi e servizi selezionati in base alle tue esigenze.',
  ],
  [
    'Posso richiedere un itinerario personalizzato?',
    'Sì. Ogni proposta viene costruita ascoltando i tuoi interessi, il tempo a disposizione, il budget e il tipo di esperienza che desideri vivere.',
  ],
  [
    'Vi occupate anche di prenotazioni?',
    'Possiamo aiutarti a individuare e organizzare le esperienze più adatte. I dettagli vengono definiti insieme prima della conferma.',
  ],
];
---

<Layout metadata={metadata}>
  <main class="bg-[#e8e1d2] text-[#050505]">
    <section
      class="relative flex min-h-svh flex-col overflow-hidden bg-[#050505] text-[#f5f2e8]"
      aria-labelledby="hero-title"
    >
      <video
        class="absolute inset-0 h-full w-full object-cover"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster="/images/rio-hero-poster.jpg"
        aria-label="Video panoramico di Rio de Janeiro"
      >
        <source src="/videos/rio-hero.mp4" type="video/mp4" />
      </video>

      <div class="absolute inset-0 bg-linear-to-r from-[#050505]/85 via-[#050505]/45 to-[#050505]/15"></div>
      <div class="absolute inset-0 bg-linear-to-t from-[#050505]/75 via-transparent to-[#050505]/20"></div>

      <div
        class="relative z-10 mx-auto my-auto w-[min(1180px,calc(100%-2rem))] pb-16 pt-24 sm:w-[min(1180px,calc(100%-3rem))]"
      >
        <p class="mb-5 text-[.68rem] font-bold uppercase tracking-[.2em] text-[#f0c95a]">RIO ELITE CONCIERGE</p>
        <h1
          id="hero-title"
          class="max-w-4xl font-serif text-[clamp(4rem,12vw,8.5rem)] font-normal leading-[.88] tracking-[-.055em]"
        >
          Rio,<br /><em class="text-[#d9a62e]">a modo tuo.</em>
        </h1>
        <p class="mt-7 max-w-md text-base leading-relaxed text-[#f5f2e8]/85 sm:text-xl">
          Esperienze autentiche, accesso privilegiato e una città tutta da vivere. Tu porta la curiosità. A tutto il
          resto pensiamo noi.
        </p>
        <div class="mt-8 flex flex-col items-start gap-5 sm:flex-row sm:items-center sm:gap-7">
          <a
            class="inline-flex items-center gap-2.5 rounded-full bg-[#d9a62e] px-5 py-3.5 text-sm font-bold text-[#050505] no-underline transition hover:-translate-y-0.5 hover:bg-[#f0c95a]"
            href="#contatti"
          >
            Inizia la tua esperienza
            <Icon name="tabler:arrow-up-right" size={19} />
          </a>
          <a class="inline-flex items-center gap-2.5 text-sm text-[#f5f2e8] no-underline" href="#esperienza">
            <span class="h-px w-9 bg-[#f5f2e8]/70"></span>
            Scopri di più
          </a>
        </div>
      </div>

      <div
        class="relative z-10 mx-auto flex w-[min(1180px,calc(100%-2rem))] justify-between pb-6 text-[.58rem] tracking-[.17em] text-[#f5f2e8]/75 sm:w-[min(1180px,calc(100%-3rem))] sm:text-[.65rem]"
      >
        <span>RIO DE JANEIRO · BRASIL</span>
        <span class="hidden items-center gap-2 sm:inline-flex">
          SCROLL TO EXPLORE
          <Icon name="tabler:arrow-down" size={15} />
        </span>
      </div>
    </section>

    <section id="esperienza" class="bg-[#e8e1d2] px-4 py-20 sm:px-6 sm:py-32">
      <div class="mx-auto grid w-full max-w-295 gap-8 md:grid-cols-2 md:gap-20 lg:gap-24">
        <div>
          <p class="mb-5 text-[.68rem] font-bold uppercase tracking-[.2em] text-[#9b6a21]">NON È UNA CHECKLIST</p>
          <h2 class="font-serif text-[clamp(3rem,7vw,5.8rem)] font-normal leading-[.92] tracking-tigher">
            Rio non si visita.<br /><em class="text-[#d9a62e]">Si sente.</em>
          </h2>
        </div>
        <div class="max-w-xl pt-0 text-[#3a403a] md:pt-9">
          <p class="font-serif text-2xl leading-snug text-[#050505]">
            È un ritmo, un’energia, una connessione. È il tramonto sul rooftop, una tavola condivisa, una strada che non
            avresti mai trovato da solo.
          </p>
          <p class="mt-5 text-base leading-7">
            Rio Elite Concierge nasce per farti vivere la città oltre i soliti itinerari. Conosciamo Rio, ascoltiamo te
            e trasformiamo il tuo viaggio in qualcosa che parla davvero del tuo modo di essere.
          </p>
          <a
            class="mt-5 inline-flex items-center gap-2 border-b border-[#d9a62e] pb-1 font-bold text-[#050505] no-underline"
            href="#contatti"
          >
            Raccontaci che Rio cerchi
            <Icon name="tabler:arrow-right" size={18} />
          </a>
        </div>
      </div>
    </section>

    <section id="servizi" class="bg-[#050505] px-4 py-20 text-[#f5f2e8] sm:px-6 sm:py-32">
      <div class="mx-auto w-full max-w-295">
        <div class="mb-14 flex flex-col justify-between gap-7 md:mb-20 md:flex-row md:items-end">
          <div>
            <p class="mb-5 text-[.68rem] font-bold uppercase tracking-[.2em] text-[#f0c95a]">
              IL TUO ACCESSO ALLA CITTÀ
            </p>
            <h2 class="font-serif text-[clamp(3rem,7vw,5.8rem)] font-normal leading-[.92] tracking-thigher">
              Più di una guida.<br /><em class="text-[#d9a62e]">La tua connessione.</em>
            </h2>
          </div>
          <p class="max-w-xs leading-7 text-[#f5f2e8]/70">
            Il nostro lavoro è trasformare le tue idee in esperienze che ricorderai molto tempo dopo essere tornato a
            casa.
          </p>
        </div>

        <div class="grid border-t border-[#f5f2e8]/25 md:grid-cols-4">
          {
            services.map((service, index) => (
              <article class="border-b border-[#f5f2e8]/25 py-7 md:mr-6 md:border-b-0 md:border-r md:pr-6 last:mr-0 last:border-0">
                <span class="mb-10 block text-[.68rem] tracking-[.15em] text-[#f0c95a]">0{index + 1}</span>
                <Icon name={service.icon} size={30} stroke-Width={1.5} />
                <h3 class="mt-5 font-serif text-2xl font-normal">{service.title}</h3>
                <p class="mt-3 text-sm leading-7 text-[#f5f2e8]/65">{service.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="come-funziona" class="bg-[#ded2bd] px-4 py-20 sm:px-6 sm:py-32">
      <div class="mx-auto w-full max-w-295">
        <div class="mb-14 flex flex-col justify-between gap-7 md:mb-20 md:flex-row">
          <div>
            <p class="mb-5 text-[.68rem] font-bold uppercase tracking-[.2em] text-[#9b6a21]">
              SEMPLICE, PERSONALE, TUO
            </p>
            <h2 class="font-serif text-[clamp(3rem,7vw,5.8rem)] font-normal leading-[.92] tracking-tighter">
              Il tuo viaggio<br /><em class="text-[#d9a62e]">inizia qui.</em>
            </h2>
          </div>
        </div>

        <div class="grid gap-8 md:grid-cols-3 md:gap-9">
          {
            steps.map(([number, title, description]) => (
              <article class="border-t border-[#050505]/30 pt-5">
                <span class="mb-10 block text-[.68rem] tracking-[.15em] text-[#9b6a21]">{number}</span>
                <h3 class="font-serif text-2xl font-normal">{title}</h3>
                <p class="mt-3 leading-7 text-[#3a403a]">{description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="bg-[#e8e1d2] px-4 py-20 sm:px-6 sm:py-32" aria-label="Esperienze a Rio">
      <div class="mx-auto w-full max-w-295">
        <div class="mb-12 flex flex-col justify-between gap-7 md:mb-16 md:flex-row md:items-end">
          <div>
            <p class="mb-5 text-[.68rem] font-bold uppercase tracking-[.2em] text-[#9b6a21]">TROVA IL TUO RITMO</p>
            <h2 class="font-serif text-[clamp(3rem,7vw,5.8rem)] font-normal leading-[.92] tracking-tighter">
              Una città.<br /><em class="text-[#d9a62e]">Mille modi di viverla.</em>
            </h2>
          </div>
          <p class="max-w-xs leading-7 text-[#3a403a]">Non esiste una sola Rio. Esiste quella che scopri tu.</p>
        </div>
      </div>

      <div
        class="mx-auto grid max-w-345 grid-cols-2 grid-rows-[220px_170px_170px] gap-2.5 sm:grid-rows-[260px_260px] sm:gap-4 md:grid-cols-[1.25fr_.75fr_.75fr]"
      >
        <a class="group relative row-span-2 overflow-hidden" href="#contatti">
          <div
            class="h-full min-h-42.5 bg-[linear-gradient(135deg,rgba(30,50,40,.2),rgba(190,120,30,.75)),url('https://images.unsplash.com/photo-1483729558449-99ef09a8c325?auto=format&fit=crop&w=1200&q=80')] bg-cover bg-center transition duration-500 group-hover:scale-105"
          >
          </div>
          <span class="absolute bottom-4 left-4 font-serif text-lg text-white sm:bottom-5 sm:left-5 sm:text-xl"
            >Tramonti e rooftop</span
          >
        </a>
        <a class="group relative overflow-hidden" href="#contatti">
          <div
            class="h-full min-h-42.5 bg-[linear-gradient(135deg,rgba(20,30,20,.1),rgba(20,20,10,.65)),url('https://images.unsplash.com/photo-1559339352-11d035aa65de?auto=format&fit=crop&w=900&q=80')] bg-cover bg-center transition duration-500 group-hover:scale-105"
          >
          </div>
          <span class="absolute bottom-4 left-4 font-serif text-lg text-white sm:bottom-5 sm:left-5 sm:text-xl"
            >Food e cultura</span
          >
        </a>
        <a class="group relative overflow-hidden" href="#contatti">
          <div
            class="h-full min-h-42.5px] bg-[linear-gradient(135deg,rgba(30,80,90,.1),rgba(10,35,35,.55)),url('https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=900&q=80')] bg-cover bg-center transition duration-500 group-hover:scale-105"
          >
          </div>
          <span class="absolute bottom-4 left-4 font-serif text-lg text-white sm:bottom-5 sm:left-5 sm:text-xl"
            >Mare e benessere</span
          >
        </a>
        <a class="group relative col-span-2 overflow-hidden" href="#contatti">
          <div
            class="h-full min-h-42.5px] bg-[linear-gradient(135deg,rgba(15,30,45,.1),rgba(15,20,35,.7)),url('https://images.unsplash.com/photo-1517457373958-b7bdd4587205?auto=format&fit=crop&w=1100&q=80')] bg-cover bg-center transition duration-500 group-hover:scale-105"
          >
          </div>
          <span class="absolute bottom-4 left-4 font-serif text-lg text-white sm:bottom-5 sm:left-5 sm:text-xl"
            >Nightlife e connessioni</span
          >
        </a>
      </div>
    </section>

    <section class="bg-[#ded2bd] px-4 py-20 sm:px-6 sm:py-32">
      <div class="mx-auto grid w-full max-w-295 gap-8 md:grid-cols-2 md:gap-20">
        <div>
          <p class="mb-5 text-[.68rem] font-bold uppercase tracking-[.2em] text-[#9b6a21]">DOMANDE FREQUENTI</p>
          <h2 class="font-serif text-[clamp(3rem,7vw,5.8rem)] font-normal leading-[.92] tracking-tighter">
            Prima di<br /><em class="text-[#d9a62e]">partire.</em>
          </h2>
        </div>
        <div>
          {
            faqs.map(([question, answer], index) => (
              <details class="border-t border-[#050505]/30 py-5" open={index === 0}>
                <summary class="flex cursor-pointer list-none items-center justify-between gap-5 font-serif text-xl [&::-webkit-details-marker]:hidden">
                  {question}
                  <Icon name="tabler:plus" size={21} class="shrink-0" />
                </summary>
                <p class="mt-4 max-w-xl leading-7 text-[#3a403a]">{answer}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section
      id="contatti"
      class="relative grid min-h-145 place-items-center overflow-hidden bg-[#050505] px-4 py-24 text-center text-[#f5f2e8] sm:px-6"
    >
      <div
        class="absolute inset-0 bg-[linear-gradient(rgba(5,5,5,.7),rgba(5,5,5,.8)),url('https://images.unsplash.com/photo-1483729558449-99ef09a8c325?auto=format&fit=crop&w=1800&q=80')] bg-cover bg-center"
      >
      </div>
      <div class="relative z-10 flex max-w-2xl flex-col items-center">
        <p class="mb-5 text-[.68rem] font-bold uppercase tracking-[.2em] text-[#f0c95a]">READY FOR YOUR RIO?</p>
        <h2 class="font-serif text-[clamp(3.2rem,8vw,6.7rem)] font-normal leading-[.9] tracking-tighter">
          La città ti aspetta.<br /><em class="text-[#d9a62e]">Vivila a modo tuo.</em>
        </h2>
        <p class="my-7 max-w-md leading-7 text-[#f5f2e8]/80">
          Raccontaci che esperienza stai cercando. Costruiamo insieme il tuo prossimo ricordo.
        </p>
        <a
          class="inline-flex items-center gap-2.5 rounded-full bg-[#d9a62e] px-5 py-3.5 text-sm font-bold text-[#050505] no-underline transition hover:-translate-y-0.5 hover:bg-[#f0c95a]"
          href="mailto:hello@rioeliteconcierge.com"
        >
          Parliamo del tuo viaggio
          <Icon name="tabler:arrow-up-right" size={19} />
        </a>
      </div>
    </section>
  </main>
</Layout>
