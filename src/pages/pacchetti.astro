---
import PageLayout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'Pacchetti',
  description:
    'Scopri i nostri pacchetti per vivere Rio de Janeiro e contattaci su WhatsApp per ricevere maggiori informazioni.',
};

const whatsappNumber = '393465886627';

const whatsappLink = (plan: string) =>
  `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(
    `Ciao, vorrei ricevere maggiori informazioni sul pacchetto ${plan}.`
  )}`;

const packages = [
  {
    title: 'Essential',
    period: '500€',
    description:
      'Perfetto per chi vuole scoprire i principali simboli e panorami di Rio in maniera completa e autentica.',
    items: [
      'Guida',
      'Cristo Redentore',
      'Pan di Zucchero',
      'Scalinata Selarón',
      'Mirante D. Marta',
      'Quartiere degli artisti di Santa Teresa',
      'Cattedrale di San Sebastiano',
      'Acquedotto di Lapa',
      'Havaianas Original Store Ipanema',
      'Giardino Botanico',
      'Foresta di Tijuca',
      'Vista Chinesa',
    ],
    cta: 'Prenota ora',
  },
  {
    title: 'Autentic',
    period: '900€',
    description: 'Per chi desidera vivere Rio come un local, tra comunità, cultura e shopping autentico.',
    items: [
      'Tutto ciò che include Essenziale',
      'Partita allo Stadio Maracanã',
      'Favela Rocinha',
      'Favela Vidigal (tour guidato di 3h in moto e a piedi)',
      'Mercato Popular Uruguaiana (shopping autentico)',
      'Biblioteca Gabinetto Reale',
      'Morro dos Irmãos: ritrovo alle 3, scalata per vedere Rio all’alba (esperienza unica)',
      'Moto d’acqua a Barra da Tijuca',
    ],
    cta: 'Prenota ora',
  },
  {
    title: 'EXPLOSÃO',
    period: '1.350€',
    description:
      'L’esperienza totale VIP: lusso, panorami mozzafiato e accesso esclusivo alle meraviglie naturali di Rio, con concierge personale e tour su misura.',
    items: [
      'Tutto ciò che include Essenziale e Autentico',
      'Giro in elicottero privato su Rio',
      'Escursione privata alle isole paradisiache di Angra dos Reis con barca privata, autista e chef',
      'Poligono di tiro',
      'Concierge personale',
    ],
    cta: 'Prenota ora',
    badge: 'Più richiesto',
    highlight: true,
  },
  {
    title: 'Personalizzato',
    period: 'Preventivo personalizzato',
    items: ['Analisi delle tue esigenze', 'Configurazione personalizzata', 'Preventivo dedicato'],
    cta: 'Parliamone insieme',
  },
];
---

<PageLayout metadata={metadata}>
  <main class="bg-[#e8e1d2] text-[#050505]">
    <!-- Intro -->
    <section class="bg-[#050505] px-4 pb-20 pt-32 text-[#f5f2e8] sm:px-6 sm:pb-28" aria-labelledby="pacchetti-title">
      <div class="mx-auto w-full max-w-295">
        <p class="mb-5 text-[.68rem] font-bold uppercase tracking-[.2em] text-[#f0c95a]">
          SCEGLI LA SOLUZIONE PIÙ ADATTA A TE
        </p>
        <h1
          id="pacchetti-title"
          class="max-w-4xl font-serif text-[clamp(3.2rem,10vw,7.5rem)] font-normal leading-[.9] tracking-[-.055em]"
        >
          I nostri<br /><em class="text-[#d9a62e]">pacchetti.</em>
        </h1>
        <p class="mt-7 max-w-md text-base leading-relaxed text-[#f5f2e8]/85 sm:text-xl">
          Confronta le opzioni disponibili e scrivici su WhatsApp per ricevere un preventivo o maggiori dettagli.
        </p>
      </div>
    </section>

    <!-- Pacchetti -->
    <section id="pacchetti" class="bg-[#e8e1d2] px-4 py-20 sm:px-6 sm:py-32">
      <div class="mx-auto grid w-full max-w-295 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          packages.map((pkg, index) => (
            <article
              class:list={[
                'relative flex flex-col border p-7 transition hover:-translate-y-1',
                pkg.highlight
                  ? 'border-[#050505] bg-[#050505] text-[#f5f2e8]'
                  : 'border-[#050505]/30 bg-[#ded2bd] text-[#050505]',
              ]}
            >
              {pkg.badge && (
                <span class="absolute -top-3 left-7 bg-[#d9a62e] px-3 py-1 text-[.6rem] font-bold uppercase tracking-[.15em] text-[#050505]">
                  {pkg.badge}
                </span>
              )}
              <span
                class:list={[
                  'mb-8 block text-[.68rem] tracking-[.15em]',
                  pkg.highlight ? 'text-[#f0c95a]' : 'text-[#9b6a21]',
                ]}
              >
                0{index + 1}
              </span>
              <h2 class="font-serif text-3xl font-normal">{pkg.title}</h2>
              <p
                class:list={[
                  'mt-2 text-[.68rem] font-bold uppercase tracking-[.15em]',
                  pkg.highlight ? 'text-[#f0c95a]' : 'text-[#9b6a21]',
                ]}
              >
                {pkg.period}
              </p>

              {pkg.description && (
                <p
                  class:list={['mt-4 text-sm italic leading-6', pkg.highlight ? 'text-[#f5f2e8]/80' : 'text-[#3a403a]']}
                >
                  {pkg.description}
                </p>
              )}

              <ul
                class:list={[
                  'mt-8 flex-1 space-y-3 border-t pt-6 text-sm leading-6',
                  pkg.highlight ? 'border-[#f5f2e8]/25 text-[#f5f2e8]/80' : 'border-[#050505]/30 text-[#3a403a]',
                ]}
              >
                {pkg.items.map((item) => (
                  <li class="flex gap-3">
                    <Icon name="tabler:check" size={18} class="mt-0.5 shrink-0 text-[#d9a62e]" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>

              <a
                class:list={[
                  'mt-8 inline-flex items-center justify-center gap-2.5 rounded-full px-5 py-3.5 text-sm font-bold no-underline transition hover:-translate-y-0.5',
                  pkg.highlight
                    ? 'bg-[#d9a62e] text-[#050505] hover:bg-[#f0c95a]'
                    : 'bg-[#050505] text-[#f5f2e8] hover:bg-[#d9a62e] hover:text-[#050505]',
                ]}
                href={whatsappLink(pkg.title)}
                target="_blank"
                rel="noopener noreferrer"
              >
                {pkg.cta}
                <Icon name="tabler:arrow-up-right" size={19} />
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Contatti -->
    <section
      class="grid min-h-100 place-items-center bg-[#050505] px-4 py-24 text-center text-[#f5f2e8] sm:px-6"
      aria-label="Contatti"
    >
      <div class="flex max-w-2xl flex-col items-center">
        <p class="mb-5 text-[.68rem] font-bold uppercase tracking-[.2em] text-[#f0c95a]">
          NON TROVI QUELLO CHE CERCHI?
        </p>
        <h2 class="font-serif text-[clamp(3rem,7vw,5.8rem)] font-normal leading-[.92] tracking-tighter">
          Costruiamo insieme<br /><em class="text-[#d9a62e]">la tua soluzione.</em>
        </h2>
        <a
          class="mt-8 inline-flex items-center gap-2.5 rounded-full bg-[#d9a62e] px-5 py-3.5 text-sm font-bold text-[#050505] no-underline transition hover:-translate-y-0.5 hover:bg-[#f0c95a]"
          href={whatsappLink('Personalizzato')}
          target="_blank"
          rel="noopener noreferrer"
        >
          Parliamo del tuo viaggio
          <Icon name="tabler:arrow-up-right" size={19} />
        </a>
      </div>
    </section>
  </main>
</PageLayout>
