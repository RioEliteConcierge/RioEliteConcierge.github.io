---
import { Icon } from 'astro-icon/components';
import ToggleMenu from '~/components/common/ToggleMenu.astro';

import { getHomePermalink, trimSlash } from '~/utils/permalinks';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
}

interface MenuLink extends Link {
  links?: Array<MenuLink>;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  position?: string;
}

const {
  id = 'header',
  links = [],
  isSticky = true,
  isDark = true,
  isFullWidth = false,
  position = 'center',
} = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;

const isActive = (href?: string) =>
  typeof href === 'string' && href.startsWith('/') && `/${trimSlash(href)}` === currentPath;

const persistKey = `rio-header-${Array.from(JSON.stringify({ links, isSticky, isDark, isFullWidth, position }))
  .reduce((hash, char) => (hash * 31 + char.charCodeAt(0)) >>> 0, 7)
  .toString(36)}`;
---

<aw-header transition:persist={persistKey}>
  <header
    id={id}
    class:list={[
      {
        sticky: isSticky,
        relative: !isSticky,
        dark: isDark,
      },
      'top-0 z-50 w-full border-b border-[#f5f2e8]/10 bg-[#050505]/90 text-[#f5f2e8] backdrop-blur-md transition-all duration-300',
    ]}
    {...isSticky ? { 'data-aw-sticky-header': true } : {}}
  >
    <div class="absolute inset-0 bg-[#050505]/70"></div>

    <div
      class:list={[
        'relative mx-auto flex w-full items-center justify-between px-4 py-4 sm:px-6 lg:px-8',
        { 'max-w-7xl': !isFullWidth },
      ]}
    >
      <a
        class="group flex flex-col leading-none no-underline"
        href={getHomePermalink()}
        aria-label="Rio Elite Concierge home"
      >
        <span class="text-xl font-extrabold tracking-[.19em] text-[#f5f2e8] transition group-hover:text-[#f0c95a]">
          RIO
        </span>
        <span class="mt-1 text-[.42rem] tracking-[.24em] text-[#d9a62e]">ELITE CONCIERGE</span>
      </a>

      <nav class="hidden items-center lg:flex" aria-label="Navigazione principale">
        <ul class="flex items-center gap-2 text-sm font-medium">
          {
            links.map(({ text, href, links: children }) => (
              <li class:list={[children?.length ? 'dropdown relative' : '']}>
                {children?.length ? (
                  <>
                    <button
                      type="button"
                      class="flex items-center gap-1 rounded-full px-4 py-2.5 text-[#f5f2e8]/90 transition hover:text-[#f0c95a]"
                    >
                      {text}
                      <Icon name="tabler:chevron-down" class="h-3.5 w-3.5" />
                    </button>
                    <ul class="dropdown-menu absolute left-0 top-full hidden min-w-52 rounded-xl border border-[#d9a62e]/20 bg-[#11100d]/95 py-2 shadow-2xl backdrop-blur-md">
                      {children.map(({ text: childText, href: childHref }) => (
                        <li>
                          <a
                            class:list={[
                              'block whitespace-nowrap px-5 py-2.5 text-[#f5f2e8]/90 transition hover:bg-[#d9a62e]/10 hover:text-[#f0c95a]',
                              { 'aw-link-active': isActive(childHref) },
                            ]}
                            href={childHref}
                          >
                            {childText}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </>
                ) : (
                  <a
                    class:list={[
                      'relative block rounded-full px-4 py-2.5 text-[#f5f2e8]/90 transition hover:text-[#f0c95a]',
                      { 'aw-link-active': isActive(href) },
                    ]}
                    href={href}
                  >
                    {text}
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="hidden items-center gap-3 lg:flex">
        <a
          class="inline-flex items-center gap-2 rounded-full bg-[#d9a62e] px-5 py-2.5 text-sm font-semibold text-[#050505] no-underline transition hover:bg-[#f0c95a] hover:-translate-y-0.5"
          href="/#contatti"
        >
          Parliamone
          <Icon name="tabler:arrow-up-right" size={17} />
        </a>
      </div>

      <div class="flex items-center lg:hidden">
        <ToggleMenu />
      </div>
    </div>
  </header>
</aw-header>

<style>
  aw-header {
    display: contents;
  }

  aw-header header.scroll {
    background: rgba(5, 5, 5, 0.98);
    box-shadow: 0 10px 35px rgba(0, 0, 0, 0.28);
  }

  aw-header .aw-link-active {
    color: #f0c95a;
  }

  aw-header .dropdown:hover > .dropdown-menu,
  aw-header .dropdown:focus-within > .dropdown-menu {
    display: block;
  }

  @media (max-width: 1023px) {
    aw-header header.expanded {
      background: #050505;
    }

    aw-header header.expanded nav {
      display: flex;
      min-height: calc(100vh - 76px);
      padding: 2rem 0;
    }

    aw-header header.expanded nav ul {
      width: 100%;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
      font-size: 1.35rem;
    }

    aw-header header.expanded nav a,
    aw-header header.expanded nav button {
      padding: 0.85rem 0;
    }
  }
</style>

<script>
  class AwHeader extends HTMLElement {
    private onScroll?: () => void;
    private mql?: MediaQueryList;
    private onMqlChange?: () => void;
    private onPageLoad = () => {
      this.updateActiveLinks();
      this.closeOpenDropdown();
    };

    connectedCallback() {
      const header = this.querySelector<HTMLElement>('#header');
      const toggle = this.querySelector<HTMLElement>('[data-aw-toggle-menu]');
      const nav = this.querySelector<HTMLElement>('#header nav');

      this.updateActiveLinks();
      document.addEventListener('astro:page-load', this.onPageLoad);

      const closeMenu = () => {
        toggle?.classList.remove('expanded');
        toggle?.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('overflow-hidden');
        header?.classList.remove('h-screen', 'expanded');
        nav?.classList.add('hidden');
      };

      toggle?.addEventListener('click', () => {
        const expanded = toggle.classList.toggle('expanded');
        toggle.setAttribute('aria-expanded', String(expanded));
        document.body.classList.toggle('overflow-hidden');
        header?.classList.toggle('h-screen');
        header?.classList.toggle('expanded');
        nav?.classList.toggle('hidden');
      });

      nav?.addEventListener('click', closeMenu);

      this.mql = window.matchMedia('(max-width: 1023px)');
      this.onMqlChange = () => closeMenu();
      this.mql.addEventListener('change', this.onMqlChange);

      if (header?.hasAttribute('data-aw-sticky-header')) {
        let ticking = false;
        const applyStyles = () => {
          header.classList.toggle('scroll', window.scrollY > 60);
          ticking = false;
        };

        this.onScroll = () => {
          if (!ticking) {
            window.requestAnimationFrame(applyStyles);
            ticking = true;
          }
        };

        applyStyles();
        document.addEventListener('scroll', this.onScroll, { passive: true });
      }

      document.documentElement.classList.add('motion-safe:scroll-smooth');
    }

    disconnectedCallback() {
      if (this.onScroll) document.removeEventListener('scroll', this.onScroll);
      if (this.mql && this.onMqlChange) this.mql.removeEventListener('change', this.onMqlChange);
      document.removeEventListener('astro:page-load', this.onPageLoad);
    }

    private closeOpenDropdown() {
      const active = document.activeElement as HTMLElement | null;
      if (active && this.contains(active) && active.closest('.dropdown')) active.blur();
    }

    private updateActiveLinks() {
      const norm = (path: string) => `/${path.replace(/^\/+|\/+$/g, '')}`;
      const current = norm(window.location.pathname);

      this.querySelectorAll<HTMLAnchorElement>('nav a[href]').forEach((anchor) => {
        const url = new URL(anchor.href, window.location.href);
        const isPathLink =
          url.origin === window.location.origin && !url.hash && !anchor.getAttribute('href')?.startsWith('#');

        anchor.classList.toggle('aw-link-active', isPathLink && norm(url.pathname) === current);
      });
    }
  }

  if (!customElements.get('aw-header')) {
    customElements.define('aw-header', AwHeader);
  }
</script>
